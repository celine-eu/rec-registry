# Deployment posture: CELINE_ENV (then ENVIRONMENT). Only `dev` accepts the
# development defaults (the local database password, the local Keycloak,
# AUTH_ENABLED/POLICIES_ENABLED=false). Unset, empty or any other value
# (staging, prod) is hardened: startup refuses them and lists every one.
# It is read from the process environment, NOT from this file: export it, or
# use `task run`, which sets CELINE_ENV=dev unless it is already set.
#   export CELINE_ENV=dev

# Database (the default carries the local stack's password: dev only)
DATABASE_URL=postgresql+asyncpg://postgres:securepassword123@host.docker.internal:15432/celine_rec_registry
DATABASE_ECHO=false

# Authentication (JWT). Every token on /admin and /user is verified against the
# issuer's JWKS. Outside dev the issuer and JWKS must be stated explicitly.
CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
CELINE_OIDC_JWKS_URI=http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/certs
CELINE_OIDC_AUDIENCE=svc-rec-registry
# The service's own client, only if it needs one. Outside dev the secret may not
# be empty or equal to the client id.
# CELINE_OIDC_CLIENT_ID=svc-rec-registry
# CELINE_OIDC_CLIENT_SECRET=
# Optional user extraction on paths outside /admin and /user (refused as false outside dev)
AUTH_ENABLED=true
AUTH_HEADER_NAME=authorization

# Policies, evaluated in-process from the Rego bundle (refused as false outside dev:
# with policies off any validly signed token is a full administrator of /admin)
POLICIES_ENABLED=true
POLICIES_DIR=./policies
# POLICIES_DATA_DIR=
POLICIES_PACKAGE=celine.rec_registry.access
POLICIES_RESOURCE_TYPE=rec_registry
POLICIES_SOURCE_SERVICE=rec-registry
POLICIES_CACHE_ENABLED=true
POLICIES_CACHE_TTL=300
