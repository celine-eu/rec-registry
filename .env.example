# Authentication (JWT)
AUTH_ENABLED=true
AUTH_VERIFY_JWT=false          # Set true for production with JWKS
AUTH_JWKS_URI=http://keycloack.celine.localhost/realms/celine/.well-known/jwks.json
AUTH_ISSUER=http://keycloack.celine.localhost
AUTH_AUDIENCE=rec-registry
AUTH_HEADER_NAME=authorization

# Policies service
POLICIES_ENABLED=true
POLICIES_URL=http://api.celine.localhost/policies
POLICIES_TIMEOUT=5.0
POLICIES_RESOURCE_TYPE=rec_registry
POLICIES_SOURCE_SERVICE=rec-registry